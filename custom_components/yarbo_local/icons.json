{
  "entity": {
    "sensor": {
      "activity": {
        "default": "mdi:robot-mower",
        "state": {
          "sleeping": "mdi:sleep",
          "idle": "mdi:robot-mower-outline",
          "charging": "mdi:battery-charging",
          "returning": "mdi:home-import-outline",
          "paused": "mdi:pause-circle-outline",
          "error": "mdi:alert-circle"
        }
      },
      "head_type": {
        "default": "mdi:puzzle"
      },
      "ambient_temperature": {
        "default": "mdi:thermometer"
      },
      "error_code": {
        "default": "mdi:alert-circle-outline"
      },
      "battery_health": {
        "default": "mdi:battery-heart-variant"
      },
      "rtk_status": {
        "default": "mdi:satellite-variant"
      },
      "network_path": {
        "default": "mdi:lan"
      },
      "firmware": {
        "default": "mdi:chip"
      },
      "satellites": {
        "default": "mdi:satellite-variant"
      },
      "heading": {
        "default": "mdi:compass"
      },
      "position_x": {
        "default": "mdi:axis-x-arrow"
      },
      "position_y": {
        "default": "mdi:axis-y-arrow"
      },
      "halow_rssi": {
        "default": "mdi:wifi"
      },
      "battery_current": {
        "default": "mdi:current-dc"
      },
      "battery_voltage": {
        "default": "mdi:flash"
      },
      "body_firmware": {
        "default": "mdi:chip"
      },
      "obstacles_this_run": {
        "default": "mdi:map-marker-alert-outline"
      },
      "fault": {
        "default": "mdi:alert-circle",
        "state": {
          "none": "mdi:check-circle-outline",
          "tilted": "mdi:rotate-left-variant"
        }
      },
      "pause_reason": {
        "default": "mdi:pause-circle-outline",
        "state": {
          "not_paused": "mdi:play-circle-outline"
        }
      },
      "plan_status": {
        "default": "mdi:clipboard-text-outline",
        "state": {
          "running": "mdi:clipboard-play-outline",
          "paused": "mdi:clipboard-clock-outline",
          "recharging": "mdi:battery-charging"
        }
      },
      "plan_progress": {
        "default": "mdi:progress-check"
      },
      "plan_remaining": {
        "default": "mdi:timer-sand"
      },
      "last_completed": {
        "default": "mdi:calendar-check"
      }
    },
    "binary_sensor": {
      "awake": {
        "default": "mdi:sleep",
        "state": {
          "on": "mdi:eye"
        }
      },
      "rtk_fix": {
        "default": "mdi:crosshairs-gps"
      },
      "person_detection": {
        "default": "mdi:motion-sensor"
      },
      "follow_mode": {
        "default": "mdi:walk"
      },
      "child_lock": {
        "default": "mdi:lock"
      }
    },
    "button": {
      "wake": {
        "default": "mdi:alarm"
      },
      "refresh": {
        "default": "mdi:refresh"
      },
      "return_to_dock": {
        "default": "mdi:home-import-outline"
      },
      "resume": {
        "default": "mdi:play"
      },
      "pause": {
        "default": "mdi:pause"
      },
      "stop": {
        "default": "mdi:stop"
      },
      "start": {
        "default": "mdi:play"
      }
    },
    "image": {
      "map": {
        "default": "mdi:map"
      }
    },
    "event": {
      "obstacle": {
        "default": "mdi:alert-octagon-outline"
      },
      "plan": {
        "default": "mdi:clipboard-play-outline"
      }
    },
    "lawn_mower": {
      "mower": {
        "default": "mdi:robot-mower"
      }
    },
    "select": {
      "plan": {
        "default": "mdi:clipboard-list-outline"
      }
    }
  },
  "services": {
    "get_map": {
      "service": "mdi:map-search"
    },
    "get_obstacles": {
      "service": "mdi:map-marker-alert"
    },
    "start_plan": {
      "service": "mdi:play"
    }
  }
}
